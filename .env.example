# Copy to .env.local and fill in from Supabase > Project Settings > API.
# .env.local is git-ignored. Never commit real values.

# Safe for the browser.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-side only: seed script, edge functions, CSV import, rewrite_log writes.
SUPABASE_SERVICE_ROLE_KEY=

# Used by `supabase db push` (Project Settings > Database). Optional if you prefer the prompt.
SUPABASE_DB_PASSWORD=

# Shared secret typed into /import. Any long random string. Importing is off when unset.
IMPORT_KEY=
